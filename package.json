{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:routes": "bash scripts/check.sh",
    "clean": "rm -rf .next node_modules package-lock.json",
    "build:clean": "rm -rf .next && npm run build",
    "verify": "bash scripts/guard-prosera-only.sh && bash scripts/guard-primitives-only.sh && node -e \"const fs=require('fs'); const t=JSON.parse(fs.readFileSync('tsconfig.json','utf8')); const ex=(t.exclude||[]).join(' '); if(!ex.includes('vendor/**')) { console.error('FAIL: tsconfig.json must exclude vendor/**'); process.exit(1);} console.log('OK: vendor/** excluded');\" && npm run build:clean",
    "build:strict": "rm -rf .next && (npm run build 2>&1 | tee .build.log | grep -q \"vendor/\" && echo \"FAIL: vendor/ appeared in build output\" && exit 1 || echo \"OK: no vendor/ in build output\") && rm -f .build.log || true",
    "bootstrap": "bash scripts/bootstrap.sh",
    "guard:prosera-only": "bash scripts/guard-prosera-only.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "mermaid": "^10.9.5",
    "motion": "^12.42.2",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "papaparse": "^5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
